rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated and matches userId
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // User profile document and subcollections (saved posts, search history, preferences)
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Public Las Vegas community posts
    match /community_posts/{postId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Vehicle Identification and Corridor Tracking Records
    match /vehicles/{vehicleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Live locations of people you know and active Google account contacts
    match /live_locations/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId);
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
